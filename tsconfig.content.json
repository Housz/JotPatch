{
  "compilerOptions": {
    "target": "ES2022",
    "module": "none",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "skipLibCheck": true,
    "outFile": "dist/content.js",
    "removeComments": false,
    "noEmitOnError": true
  },
  "files": [
    "src/content/types.ts",
    "src/content/page-key.ts",
    "src/content/anchor.ts",
    "src/content/conversation.ts",
    "src/content/markdown.ts",
    "src/content/conversation-index.ts",
    "src/content/navigation-recovery.ts",
    "src/content/rail-layout.ts",
    "src/content/repository.ts",
    "src/content/paper-styles.ts",
    "src/content/app.ts",
    "src/content/entry.ts"
  ]
}
