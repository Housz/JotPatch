{
  "manifest_version": 3,
  "name": "JotPatch — Stage 0",
  "version": "0.0.1",
  "description": "Pin a small note to selected webpage text and find it again.",
  "action": {
    "default_title": "Enable JotPatch on this page"
  },
  "background": {
    "scripts": ["dist/background.js"]
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "jotpatch@housz.dev",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
