{
  "manifest_version": 3,
  "name": "JotPatch",
  "short_name": "JotPatch",
  "version": "0.1.14",
  "description": "JotPatch · 随地大小贴。",
  "action": {
    "default_title": "JotPatch · 打开当前网页的便签",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "dist/background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "minimum_chrome_version": "116",
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
