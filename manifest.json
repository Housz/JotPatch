{
  "manifest_version": 3,
  "name": "JotPatch — Stage 0",
  "short_name": "JotPatch",
  "version": "0.0.1",
  "description": "Pin a small note to selected webpage text and find it again.",
  "action": {
    "default_title": "Enable JotPatch on this page"
  },
  "background": {
    "service_worker": "dist/background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "minimum_chrome_version": "116",
  "options_page": "options.html"
}
